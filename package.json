{
  "name": "localdeck",
  "version": "1.0.0",
  "private": true,
  "description": "Een moderne lokale PHP-ontwikkelomgeving exclusief voor Windows 10 en 11",
  "author": "LocalDeck",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "test": "vitest run",
    "check": "tsc -p tsconfig.electron.json && tsc --noEmit && vitest run",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron-store": "^10.0.1",
    "lucide-react": "^0.468.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "~1.5.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "nl.localdeck.app",
    "productName": "LocalDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "installer",
        "filter": [
          "*.ps1",
          "*.vbs",
          "*.json",
          "startpage/**/*",
          "web-control/**/*"
        ]
      },
      {
        "from": "runtime-packages",
        "to": "installer/packages",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "INSTALLEREN.md",
        "to": "INSTALLEREN.md"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "extraFiles": [
      {
        "from": "scripts/localdeck.cmd",
        "to": "localdeck.cmd"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "LocalDeck-${version}-Windows-Setup-${arch}.${ext}"
    }
  }
}
